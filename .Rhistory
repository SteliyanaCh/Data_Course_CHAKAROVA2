# ---------------------------------------------------
# Assignment 6 — Data Tidying, ggplot, and gganimate
# ---------------------------------------------------
# 🧰 Step 1: Install & load packages
required_packages <- c("tidyverse", "here", "gganimate", "gifski", "transformr")
# Loop through and install missing ones
for (pkg in required_packages) {
if (!require(pkg, character.only = TRUE)) {
install.packages(pkg, dependencies = TRUE)
library(pkg, character.only = TRUE)
} else {
library(pkg, character.only = TRUE)
}
}
cat("\n✅ All packages loaded!\n")
# ---------------------------------------------------
# 🧪 Step 2: Load data
# ---------------------------------------------------
dat <- read_csv(here("Data", "BioLog_Plate_Data.csv"))
cat("\n--- COLUMN NAMES ---\n")
print(colnames(dat))
cat("--------------------\n")
# ---------------------------------------------------
# 🧹 Step 3: Tidy data
# ---------------------------------------------------
dat_tidy <- dat %>%
pivot_longer(
cols = starts_with("Hr_"),
names_to = "Time_hr",
values_to = "Absorbance"
) %>%
mutate(
Time_hr = as.numeric(str_replace(Time_hr, "Hr_", "")),
SourceType = case_when(
str_detect(`Sample ID`, "Soil") ~ "Soil",
str_detect(`Sample ID`, "Water") ~ "Water",
TRUE ~ "Other"
)
)
cat("\n✅ Data tidied successfully!\n")
glimpse(dat_tidy)
# ---------------------------------------------------
# 📊 Step 4: Static Plot
# ---------------------------------------------------
plot_static <- dat_tidy %>%
filter(Dilution == 0.1) %>%
ggplot(aes(x = Time_hr, y = Absorbance, color = SourceType)) +
geom_point(alpha = 0.7) +
geom_line(aes(group = interaction(Substrate, SourceType)), alpha = 0.5) +
facet_wrap(~Substrate, scales = "free_y") +
theme_bw() +
labs(
title = "Carbon Source Utilization at Dilution 0.1",
subtitle = "Absorbance over Time by Source Type",
x = "Time (hours)",
y = "Absorbance"
)
# Show static plot in RStudio
print(plot_static)
# Create Output folder if missing
if (!dir.exists(here("Output"))) dir.create(here("Output"))
# Save static plot
ggsave(here("Output", "plot_static.png"), plot = plot_static,
width = 10, height = 6, dpi = 300)
cat("\n💾 Static plot saved as Output/plot_static.png\n")
# ---------------------------------------------------
# 🌀 Step 5: Animated Plot
# ---------------------------------------------------
itaconic_avg <- dat_tidy %>%
library(tidyverse)
library(tidyverse)
library(gganimate)
# 1. Load the data
dat <- read_csv("C:/Users/siska/Desktop/Data_Course_CHAKAROVA2/Data/BioLog_Plate_Data.csv")
# 2. Convert to tidy (long) format for time points
tidy_dat <- dat %>%
pivot_longer(
cols = starts_with("Hr_"),      # time columns
names_to = "Time",
values_to = "Absorbance"
) %>%
# Convert Time from Hr_24 → 24 numeric
mutate(Time = as.numeric(str_remove(Time, "Hr_")))
# 3. Add a Source column (Soil vs Water)
tidy_dat <- tidy_dat %>%
mutate(Source = if_else(str_detect(`Sample ID`, regex("soil", ignore_case = TRUE)),
"Soil", "Water"))
# 4. Filter for dilution == 0.1
tidy_0.1 <- tidy_dat %>%
filter(Dilution == 0.1)
# 5. Plot growth curves
plot_01 <- ggplot(tidy_0.1, aes(x = Time, y = Absorbance, color = Source, group = `Sample ID`)) +
geom_line(size = 1) +
theme_minimal(base_size = 14) +
labs(
title = "Growth Curves at Dilution 0.1",
x = "Time (hours)",
y = "Absorbance (OD)",
color = "Sample Source"
) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "right"
)
# Display static plot
print(plot_01)
# 6. (Optional) Animated version
animated_plot <- plot_01 +
transition_reveal(Time)
animate(animated_plot, width = 800, height = 500, fps = 20)
# Load required packages
library(tidyverse)
library(gganimate)
# 1. Load data
dat <- read_csv("C:/Users/siska/Desktop/Data_Course_CHAKAROVA2/Data/BioLog_Plate_Data.csv")
# 2. Convert to tidy (long) form for time points
tidy_dat <- dat %>%
pivot_longer(
cols = starts_with("Hr_"),        # pivot Hr_24, Hr_48, Hr_144
names_to = "Time",
values_to = "Absorbance"
) %>%
mutate(
# Convert time to numeric
Time = as.numeric(str_remove(Time, "Hr_")),
# Create Source column based on Sample ID
Source = if_else(str_detect(`Sample ID`, regex("soil", ignore_case = TRUE)),
"Soil", "Water")
)
# 3. STATIC PLOT: Dilution == 0.1
tidy_0.1 <- tidy_dat %>%
filter(Dilution == 0.1)
static_plot <- ggplot(tidy_0.1, aes(x = Time, y = Absorbance, color = Source, group = `Sample ID`)) +
geom_line(size = 1) +
theme_minimal(base_size = 14) +
labs(
title = "Growth Curves at Dilution 0.1",
x = "Time (hours)",
y = "Absorbance (OD)",
color = "Sample Source"
) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
# Display static plot
print(static_plot)
# 4. ANIMATED PLOT: Substrate == "Itaconic Acid", mean of 3 replicates
tidy_itac <- tidy_dat %>%
filter(Dilution == 0.1, Substrate == "Itaconic Acid") %>%
group_by(Source, Time) %>%
summarise(
Mean_Absorbance = mean(Absorbance, na.rm = TRUE),
SD_Absorbance = sd(Absorbance, na.rm = TRUE),   # optional for shading
.groups = "drop"
)
# Create animated plot
animated_plot <- ggplot(tidy_itac, aes(x = Time, y = Mean_Absorbance, color = Source)) +
geom_line(size = 1.2) +
geom_point(size = 2) +
# Optional: add shading for ± SD
geom_ribbon(aes(ymin = Mean_Absorbance - SD_Absorbance,
ymax = Mean_Absorbance + SD_Absorbance,
fill = Source), alpha = 0.2, color = NA) +
theme_minimal(base_size = 14) +
labs(
title = "Growth Curve on Itaconic Acid (Dilution 0.1)",
x = "Time (hours)",
y = "Mean Absorbance (OD)",
color = "Sample Source",
fill = "Sample Source"
) +
transition_reveal(Time) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
# Render animation
animate(animated_plot, width = 800, height = 500, fps = 20)
View(static_plot)
