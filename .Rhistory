filter(!str_detect(SampleID, "_"))
# 3. Separate SampleID into Plate and Well
tidy_dat <- tidy_dat %>%
separate(
SampleID,
into = c("Plate", "Well"),
sep = "_",
fill = "right",
extra = "merge"
)
# 4. Inspect the tidied data
head(tidy_dat)
glimpse(tidy_dat)
# 5. Example plot
ggplot(tidy_dat, aes(x = Plate, y = Measurement, fill = Well)) +
geom_col(position = "dodge") +
theme_minimal() +
labs(title = "BioLog Plate Measurements",
x = "Plate",
y = "Measurement")
